    "@types/node": "^22.10.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "drizzle-kit": "^0.31.5",
    "tailwindcss": "4.3.2",
    "tsx": "^4.20.0",
